#!/usr/bin/env Rscript

help_tokens <- c("-h", "--help")
command_aliases <- c(
  setup_project = "init",
  edit_project = "config-edit",
  run_project = "run"
)

usage_error <- function(message) {
  condition <- simpleError(message)
  class(condition) <- c("bg_cli_usage_error", class(condition))
  stop(condition)
}

or_else <- function(x, y) {
  if (is.null(x) || length(x) == 0L) y else x
}

is_flag <- function(x) {
  !is.null(x) && (isTRUE(x) || (length(x) == 1L && is.na(x)))
}

normalize_options <- function(args, allowed = character()) {
  if (length(args) == 0L) return(list())
  parsed <- BrainGnomes::parse_cli_args(args)
  names(parsed) <- gsub("-", "_", names(parsed), fixed = TRUE)
  unknown <- setdiff(names(parsed), allowed)
  if (length(unknown) > 0L) {
    usage_error(paste0("Unknown option(s): --", paste(gsub("_", "-", unknown), collapse = ", --")))
  }
  parsed
}

format_output <- function(x, format = "table") {
  format <- match.arg(tolower(format), c("table", "json", "csv"))
  payload <- switch(class(x)[1L],
    bg_project_validation = list(valid = x$valid, issues = x$issues, messages = x$messages),
    bg_project_doctor = list(ok = x$ok, checks = x$checks, checked_steps = x$checked_steps),
    bg_project_plan = list(
      schema_version = x$schema_version, plan_id = x$plan_id,
      created_at = x$created_at, config_file = x$config_file,
      request = x$request, subjects = x$subjects,
      scope_deferred = x$scope_deferred, jobs = x$jobs
    ),
    bg_project_run = unclass(x),
    bg_run_provenance = unclass(x),
    bg_project_inspection = list(
      subject_id = x$subject_id, scheduler_refreshed = x$scheduler_refreshed,
      retrieved_at = x$retrieved_at, overview = x$overview,
      active = x$active, reconciliation = x$reconciliation,
      stages = x$stages, subjects = x$subjects,
      subject_stages = x$subject_stages, runs = x$runs,
      attempts = x$attempts, jobs = x$jobs
    ),
    bg_project_diagnosis = list(
      scope = x$scope, run_id = x$run_id,
      focus = x$focus,
      overview = x$inspection$overview,
      failures = x$failures, logs = x$logs, jobs = x$jobs
    ),
    x
  )

  if (format == "json") {
    cat(jsonlite::toJSON(payload, pretty = TRUE, auto_unbox = TRUE, na = "null"), "\n")
  } else if (format == "csv") {
    if (!is.data.frame(payload)) usage_error("CSV output is available only for tabular command results.")
    utils::write.table(payload, stdout(), sep = ",", row.names = FALSE, col.names = TRUE, quote = TRUE, na = "")
  } else {
    if (inherits(x, c("bg_project_validation", "bg_project_doctor", "bg_project_plan", "bg_project_run", "bg_run_provenance", "bg_project_inspection", "bg_project_diagnosis"))) {
      print(x)
    } else {
      print(payload, row.names = FALSE)
    }
  }
  invisible(x)
}

