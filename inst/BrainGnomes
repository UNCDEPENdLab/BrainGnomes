# Separate an optional leading project path from its options. Missing paths use
# the current directory; option values must never be mistaken for project paths.
# Returns input and the untouched remaining option tokens for normalize_options.
project_cli_arguments <- function(values) {
  explicit <- length(values) > 0L && !startsWith(values[[1L]], "-")
  list(
    input = if (explicit) values[[1L]] else getwd(),
    options = if (explicit) values[-1L] else values
  )
}

command_init <- function(values) {
  if (length(values) < 1L || startsWith(values[[1L]], "-")) {
    opts <- normalize_options(values, c("template", "overwrite", "reuse_template_paths"))
    if (is_flag(opts$reuse_template_paths)) {
      usage_error("--reuse-template-paths requires a project name and prompt-free setup.")
    }
    BrainGnomes::setup_project(
      template = opts$template,
      interactive = TRUE
    )
    return(0L)
  }
  args <- project_cli_arguments(values[-1L])
  opts <- normalize_options(args$options, c("template", "overwrite", "reuse_template_paths"))
  cfg <- BrainGnomes::setup_project(
    project_name = values[[1L]],
    project_directory = args$input,
    template = opts$template,
    interactive = FALSE,
    overwrite = is_flag(opts$overwrite),
    reuse_template_paths = is_flag(opts$reuse_template_paths)
  )
  cat("Saved project configuration to:", or_else(attr(cfg, "yaml_file"), file.path(cfg$metadata$project_directory, "project_config.yaml")), "\n")
  0L
}

command_config <- function(values) {
  if (length(values) < 1L) usage_error("config requires validate, edit, or show.")
  action <- values[[1L]]
  args <- project_cli_arguments(values[-1L])
  input <- args$input
  allowed <- c("format", if (action == "validate") c("steps", "postprocess_streams", "extract_streams"))
  opts <- normalize_options(args$options, allowed)
  format <- or_else(opts$format, "table")
  if (action == "validate") {
    result <- BrainGnomes::validate_project_config(input, quiet = TRUE, steps = opts$steps,
      postprocess_streams = opts$postprocess_streams, extract_streams = opts$extract_streams)
    format_output(result, format)
    return(if (result$valid) 0L else 1L)
  }
  if (action == "edit") {
    if (format != "table") usage_error("config edit does not accept --format.")
    BrainGnomes::edit_project(input)
    return(0L)
  }
  if (action == "show") {
    cfg <- BrainGnomes::load_project(input, validate = FALSE)
    if (format == "json") format_output(as.list(cfg), format)
    else if (format == "table") summary(cfg)
    else usage_error("config show supports table or json output.")
    return(0L)
  }
  usage_error(paste0("Unknown config action: ", action))
}

command_doctor <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c("steps", "deep", "strict", "format"))
  result <- BrainGnomes::doctor_project(
    input, steps = opts$steps, deep = is_flag(opts$deep), quiet = TRUE
  )
  format_output(result, or_else(opts$format, "table"))
  has_warning <- any(result$checks$status == "warn")
  if (!result$ok || (is_flag(opts$strict) && has_warning)) 1L else 0L
}

plan_options <- c(
  "steps", "subject_filter", "postprocess_streams", "extract_streams",
  "force", "allow_invalid", "output", "overwrite", "format"
)

command_plan <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, plan_options)
  result <- BrainGnomes::plan_project(
    input, steps = or_else(opts$steps, "all"), subject_filter = opts$subject_filter,
    postprocess_streams = opts$postprocess_streams, extract_streams = opts$extract_streams,
    force = is_flag(opts$force), allow_invalid = is_flag(opts$allow_invalid), quiet = TRUE
  )
  if (!is.null(opts$output)) {
    path <- BrainGnomes::write_project_plan(result, opts$output, overwrite = is_flag(opts$overwrite))
    message("Saved plan to ", path)
  }
  format_output(result, or_else(opts$format, "table"))
  0L
}

command_run <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c(
    "steps", "subject_filter", "postprocess_streams", "extract_streams",
    "debug", "force", "dry_run", "log_level", "format"
  ))
  plan <- tryCatch(BrainGnomes::read_project_plan(input), error = function(e) NULL)
  if (!is.null(plan)) {
    disallowed <- intersect(names(opts), c("steps", "subject_filter", "postprocess_streams", "extract_streams", "force", "dry_run"))
    if (length(disallowed) > 0L) usage_error("Saved plans cannot be combined with run-selection options.")
    result <- BrainGnomes::submit_project_plan(plan, debug = is_flag(opts$debug), log_level = or_else(opts$log_level, "INFO"))
  } else {
    if (or_else(opts$format, "table") != "table" && is.null(opts$steps)) {
      usage_error("Machine-readable runs require --steps (use --steps=all for all enabled stages) or a saved plan.")
    }
    cli_args <- opts
    result <- BrainGnomes:::run_project_cli(input, cli_args)
  }
  format <- or_else(opts$format, "table")
  # Direct dry runs already print their human preview; serialize the returned
  # plan for machines without printing the same preview twice for people.
  if (format != "table" || !inherits(result, "bg_project_plan")) format_output(result, format)
  0L
}

command_validate_bids <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c("outfile", "wait_jobs", "run"))
  cfg <- BrainGnomes::load_project(input)
  job_id <- BrainGnomes::run_bids_validation(
    cfg, outfile = opts$outfile, wait_jobs = opts$wait_jobs,
    sequence_id = opts$run
  )
  cat("Submitted BIDS validation job:", job_id, "\n")
  0L
}

command_status <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c(
    "sub_id", "ses_id", "summary", "runs", "run", "view", "refresh",
    "watch", "interval", "format"
  ), formats = c("table", "json", "csv"))
  format <- or_else(opts$format, "table")
  if (is_flag(opts$watch) && format != "table") {
    usage_error("--watch requires --format=table. Poll status without --watch for a single JSON/CSV result.")
  }
  if (!is.null(opts$ses_id) && is.null(opts$sub_id)) usage_error("--ses-id requires --sub-id.")
  if (is_flag(opts$runs) && !is.null(opts$run)) usage_error("Use either --runs or --run, not both.")
  if (is_flag(opts$runs) && !is.null(opts$view)) usage_error("Use either --runs or --view, not both.")
  if (is_flag(opts$summary) && !is.null(opts$view)) usage_error("Use either --summary or --view, not both.")

  view <- if (is_flag(opts$runs)) "runs" else if (is_flag(opts$summary)) "overview" else or_else(opts$view, "dashboard")
  view <- gsub("-", "_", tolower(view), fixed = TRUE)
  allowed_views <- c(
    "dashboard", "overview", "stages", "subjects", "subject_stages",
    "runs", "attempts", "jobs", "active", "reconciliation"
  )
  if (!view %in% allowed_views) usage_error(paste0("Unknown status view: ", view))
  if (view == "dashboard" && format != "table") view <- "overview"

  interval <- suppressWarnings(as.numeric(or_else(opts$interval, 30)))
  if (!is.finite(interval) || interval <= 0) usage_error("--interval must be a positive number of seconds.")
  sub_id <- if (is.null(opts$sub_id)) NULL else sub("^sub-", "", as.character(opts$sub_id))
  ses_id <- if (is.null(opts$ses_id)) NULL else sub("^ses-", "", as.character(opts$ses_id))

  repeat {
    inspection <- BrainGnomes::inspect_project(
      input, run_id = opts$run, subject_id = sub_id,
      refresh = is_flag(opts$refresh) || view == "reconciliation"
    )
    payload <- switch(view,
      dashboard = inspection,
      overview = inspection$overview,
      stages = inspection$stages,
      subjects = inspection$subjects,
      subject_stages = inspection$subject_stages,
      runs = inspection$runs,
      attempts = inspection$attempts,
      jobs = inspection$jobs,
      active = inspection$active,
      reconciliation = inspection$reconciliation
    )
    if (!is.null(ses_id)) {
      if (view == "dashboard") {
        payload <- inspection$subject_stages
      }
      if (!is.data.frame(payload) || !"ses_id" %in% names(payload)) {
        usage_error("--ses-id requires a view with session-level rows.")
      }
      payload <- payload[
        !is.na(payload$ses_id) & payload$ses_id == ses_id, , drop = FALSE
      ]
    }
    format_output(payload, format)
    active <- inspection$overview$n_jobs_running + inspection$overview$n_jobs_queued
    if (!is_flag(opts$watch) || active == 0L) break
    Sys.sleep(interval)
  }
  0L
}

command_logs <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c("run", "failed_only", "tail", "format"),
    formats = c("table", "json", "csv"))
  logs <- BrainGnomes::find_run_logs(
    input, run_id = or_else(opts$run, "latest"), failed_only = is_flag(opts$failed_only)
  )
  format_output(logs, or_else(opts$format, "table"))
  if (!is.null(opts$tail)) {
    n <- as.integer(opts$tail)
    for (path in logs$path) {
      cat("\n==> ", path, " <==\n", sep = "")
      lines <- readLines(path, warn = FALSE)
      cat(utils::tail(lines, n), sep = "\n")
      cat("\n")
    }
  }
  0L
}

command_provenance <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c("run", "format"))
  result <- BrainGnomes::get_run_provenance(
    input, run_id = or_else(opts$run, "latest")
  )
  format_output(result, or_else(opts$format, "table"))
  0L
}

command_diagnose <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(
    args$options, c("run", "subject_id", "job_id", "interactive", "format")
  )
  if (is_flag(opts$interactive) && or_else(opts$format, "table") != "table") {
    usage_error("--interactive requires --format=table.")
  }
  if (is_flag(opts$interactive)) {
    BrainGnomes::diagnose_project(
      input, run_id = opts$run, subject_id = opts$subject_id,
      job_id = opts$job_id, interactive = TRUE
    )
  } else {
    result <- BrainGnomes::diagnose_project(
      input, run_id = opts$run, subject_id = opts$subject_id,
      job_id = opts$job_id, interactive = FALSE
    )
    format_output(result, or_else(opts$format, "table"))
  }
  0L
}

command_retry <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c("run", "include_blocked", "dry_run", "yes", "format"))
  dry_run <- is_flag(opts$dry_run)
  if (!dry_run && !is_flag(opts$yes)) usage_error("retry requires --dry-run or --yes.")
  result <- BrainGnomes::retry_project_run(
    input, or_else(opts$run, "latest"), include_blocked = is_flag(opts$include_blocked),
    dry_run = dry_run
  )
  format_output(result, or_else(opts$format, "table"))
  0L
}

command_cancel <- function(values) {
  args <- project_cli_arguments(values)
  input <- args$input
  opts <- normalize_options(args$options, c("run", "dry_run", "yes", "format"),
    formats = c("table", "json", "csv"))
  dry_run <- is_flag(opts$dry_run)
  if (!dry_run && !is_flag(opts$yes)) usage_error("cancel requires --dry-run or --yes.")
  result <- BrainGnomes::cancel_project_run(input, or_else(opts$run, "latest"), dry_run = dry_run)
  format_output(result, or_else(opts$format, "table"))
  0L
}

main <- function() {
  output_depth <- sink.number(type = "output")
  on.exit(while (sink.number(type = "output") > output_depth) sink(type = "output"), add = TRUE)
  args <- commandArgs(trailingOnly = TRUE)
  if (length(args) == 0L) print_global_help(status = 1L)
  if (args[[1L]] %in% help_tokens) print_global_help(status = 0L)
  if (identical(args[[1L]], "help")) {
    if (length(args) == 1L) print_global_help(status = 0L)
    print_command_help(args[[2L]], status = 0L)
  }

  command <- args[[1L]]
  values <- args[-1L]
  if (any(values %in% help_tokens)) print_command_help(command, status = 0L)
  # Package startup output is diagnostic, even before --format is parsed.
  sink(stderr(), type = "output")
  if (!requireNamespace("BrainGnomes", quietly = TRUE)) stop("BrainGnomes package is required to run this command.")
  if (!requireNamespace("jsonlite", quietly = TRUE)) stop("The jsonlite package is required to run this command.")
  sink(type = "output")

  if (command %in% names(command_aliases)) command <- unname(command_aliases[[command]])
  if (command == "config-edit") {
    command <- "config"
    values <- c("edit", values)
  }
  status <- switch(command,
    init = command_init(values),
    config = command_config(values),
    doctor = command_doctor(values),
    plan = command_plan(values),
    run = command_run(values),
    `validate-bids` = command_validate_bids(values),
    status = command_status(values),
    provenance = command_provenance(values),
    logs = command_logs(values),
    diagnose = command_diagnose(values),
    retry = command_retry(values),
    cancel = command_cancel(values),
    {
      message("Unknown command: ", command)
      sink(stderr(), type = "output")
      print_global_help(status = 2L)
    }
  )
  while (sink.number(type = "output") > output_depth) sink(type = "output")
  if (!is.null(cli_output$payload)) cat(cli_output$payload, "\n", sep = "")
  status
}

status <- tryCatch(
  main(),
  bg_cli_usage_error = function(e) {
    message("Usage error: ", conditionMessage(e))
    2L
  },
  error = function(e) {
    message("Error: ", conditionMessage(e))
    1L
  }
)
quit(save = "no", status = as.integer(status))
